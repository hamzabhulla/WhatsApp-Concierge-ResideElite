# Copy this file to ".env" for local development (npm run dev).
# On Vercel / Netlify add the same two names under Project Settings -> Environment Variables.
#
# IMPORTANT: every VITE_* variable is compiled into the PUBLIC JavaScript that every visitor
# downloads. Only values that are safe to be public may go here:
#   - the Supabase project URL and the ANON ("publishable") key are meant to be public,
#     but ONLY while Row Level Security is on (run supabase/setup.sql).
#   - NEVER put the service-role / secret key, an API key or a password in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
